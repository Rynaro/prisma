# Phase 4 scaffold .env.example — placeholder values only.
# Copy to .env and fill in for local development. The scaffold runs without
# real values; secrets are only required once Phase 5 wires the GitHub and
# provider calls.

# --- Server ---
PORT=3000
LOG_LEVEL=info
NODE_ENV=development

# --- GitHub App (secret) ---
GITHUB_APP_ID=
GITHUB_APP_SLUG=
GITHUB_APP_PRIVATE_KEY=
GITHUB_APP_WEBHOOK_SECRET=

# --- Provider (secret) ---
# The worker selects a provider by precedence:
#   ANTHROPIC_API_KEY → COPILOT_API_KEY → OPENAI_API_KEY → FakeProvider
# Set exactly one of the keys for production-equivalent behavior.
ANTHROPIC_API_KEY=
COPILOT_API_KEY=
# Optional Copilot overrides; sensible defaults baked into the adapter.
COPILOT_MODEL=
COPILOT_BASE_URL=
OPENAI_API_KEY=
# Optional OpenAI overrides; sensible defaults baked into the adapter.
OPENAI_MODEL=
OPENAI_BASE_URL=
# OPENAI_TOKEN_PARAM: auto (default) | max_tokens | max_completion_tokens
# auto: max_completion_tokens for gpt-5+/o-series/gpt-6/chat-latest, max_tokens for classic models.
OPENAI_TOKEN_PARAM=
# OPENAI_MAX_OUTPUT_TOKENS: output token budget. Default 4096 (classic) / 32768 (reasoning models).
OPENAI_MAX_OUTPUT_TOKENS=
# OPENAI_TOOL_CHOICE: auto (default) | forced | required. auto already sends 'required' to reasoning models.
OPENAI_TOOL_CHOICE=
# OPENAI_API_STYLE: auto (default) | chat | responses. auto routes reasoning models to /responses.
OPENAI_API_STYLE=

# --- Queue ---
REDIS_URL=redis://redis:6379

# --- Idempotency / replay protection ---
INSTALLATION_REPLAY_WINDOW_SECONDS=300

# --- Worker tunables ---
QUEUE_CONCURRENCY=4
JOB_TIMEOUT_SECONDS=120

# --- Retry tunables ---
RETRY_TRANSIENT_MAX_ATTEMPTS=3
RETRY_TRANSIENT_BACKOFF_BASE_MS=500
RETRY_TRANSIENT_BACKOFF_MAX_MS=8000
RETRY_RATELIMIT_MAX_ATTEMPTS=5

# --- Cost ceiling ---
MAX_TOKENS_PER_PR=60000
MAX_TOKENS_PER_WINDOW_PER_INSTALLATION=2000000
MAX_TOKENS_WINDOW_SECONDS=3600

# --- OpenTelemetry (optional; leave OTEL_EXPORTER_OTLP_ENDPOINT empty to disable export) ---
OTEL_SERVICE_NAME=prisma-review-bot
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_TRACES_SAMPLER_ARG=1.0
